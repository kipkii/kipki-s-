import pandas as pd
import matplotlib.pyplot as plt

# 1. 한글 폰트 및 마이너스 기호 깨짐 방지 설정
plt.rcParams['font.family'] = 'Malgun Gothic'
plt.rcParams['axes.unicode_minus'] = False

# 2. 파일 경로 설정 (백슬래시 에러 방지를 위해 슬래시(/) 사용)
file_path = 'd:/상명대학교자료/26-1(4)/1. 파이썬프로그래밍/성적집계표.txt'

try:
    # 데이터 불러오기 (탭으로 구분된 텍스트 파일)
    df = pd.read_csv(file_path, sep='\t', encoding='cp949')
    
    # 3. 통합점수 계산
    df['통합점수'] = df['중간점수'] + df['기말점수'] + df['출석점수'] + df['과제점수']

    # 4. 요약 통계 계산 및 출력
    print("=== 각 번호별 통합점수 ===")
    print(df[['번호', '통합점수']].to_string(index=False))
    
    print("\n=== 전체 성적 요약 ===")
    print(f"평균 점수: {df['통합점수'].mean():.2f}점")
    print(f"최고 점수: {df['통합점수'].max():.2f}점")
    print(f"최저 점수: {df['통합점수'].min():.2f}점")
    print(f"중간 점수: {df['통합점수'].median():.2f}점")

    # 5. 시각화 (Subplot 3개 배치)
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))

    # 10점 단위 Bins 설정 (중간/기말은 40점까지, 통합은 100점까지 여유 있게)
    bins_mid_final = range(0, 41, 10)
    bins_total = range(0, 101, 10)

    # 그래프 1: 중간점수
    axes[0].hist(df['중간점수'], bins=bins_mid_final, color='skyblue', edgecolor='black')
    axes[0].set_title('중간점수 분포')
    axes[0].set_xlabel('점수 구간')
    axes[0].set_ylabel('학생 수 (명)')
    axes[0].set_xticks(bins_mid_final)

    # 그래프 2: 기말점수
    axes[1].hist(df['기말점수'], bins=bins_mid_final, color='lightgreen', edgecolor='black')
    axes[1].set_title('기말점수 분포')
    axes[1].set_xlabel('점수 구간')
    axes[1].set_ylabel('학생 수 (명)')
    axes[1].set_xticks(bins_mid_final)

    # 그래프 3: 통합점수
    axes[2].hist(df['통합점수'], bins=bins_total, color='salmon', edgecolor='black')
    axes[2].set_title('통합점수 분포')
    axes[2].set_xlabel('점수 구간')
    axes[2].set_ylabel('학생 수 (명)')
    axes[2].set_xticks(bins_total)

    # 간격 조정 및 출력
    plt.tight_layout()
    plt.show()

except FileNotFoundError:
    print("파일을 찾을 수 없습니다. 폴더 안에 '성적집계표.txt' 파일이 정확히 있는지 확인해 주세요.")
except Exception as e:
    print(f"알 수 없는 오류가 발생했습니다: {e}")